import os
import re
import ast
import shutil
from datetime import datetime


ENGINE_FOLDER = os.path.dirname(
    os.path.abspath(__file__)
)

DOWNLOADER = os.path.join(
    ENGINE_FOLDER,
    "downloader.py"
)


def make_backup():
    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    backup = (
        DOWNLOADER
        + ".backup_"
        + timestamp
    )

    shutil.copy2(
        DOWNLOADER,
        backup
    )

    return backup


def check_syntax(path):
    with open(
        path,
        "r",
        encoding="utf-8-sig"
    ) as f:
        source = f.read()

    ast.parse(
        source,
        filename=path
    )


def find_function_end(lines, start):
    """
    Находит конец функции по отступам.
    start — индекс строки с def.
    """

    base_indent = len(
        lines[start]
    ) - len(
        lines[start].lstrip()
    )

    index = start + 1

    while index < len(lines):
        line = lines[index]

        stripped = line.strip()

        if not stripped:
            index += 1
            continue

        indent = len(line) - len(
            line.lstrip()
        )

        if (
            indent <= base_indent
            and not line.lstrip().startswith("#")
        ):
            break

        index += 1

    return index


def find_function(lines, name):
    pattern = re.compile(
        rf"^def\s+{re.escape(name)}\s*\("
    )

    for index, line in enumerate(lines):
        if pattern.search(line):
            return index

    return None


def build_youtube_search_function():
    return r'''

# YOUTUBE FALLBACK SEARCH FOR NON-YOUTUBE SOURCES

def find_youtube_fallback_url(
    artist,
    title,
    target_duration=None
):
    """
    Ищет подходящий YouTube-трек по метаданным.

    Используется только для исходников,
