def main():

    print(
        "=" * 70
    )

    print(
        "CENSURU.NET — ВОССТАНОВЛЕНИЕ "
        "SOUNDCLOUD ИЗ GITHUB"
    )

    print(
        "=" * 70
    )

    # --------------------------------------------------------
    # 1
    # --------------------------------------------------------

    print(
        "\n1/8: проверка downloader.py..."
    )

    current_source, current_tree, current_funcs = (
        validate_current_downloader()
    )

    print(
        "  OK: синтаксис."
    )

    print(
        f"  Найдено top-level функций: "
        f"{len(current_funcs)}"
    )

    # --------------------------------------------------------
    # 2
    # --------------------------------------------------------

    print(
        "\n2/8: поиск SoundCloud-модуля..."
    )

    module_source = (
        download_github_module()
    )

    module_origin = (
        "GitHub"
        if module_source is not None
        else None
    )

    # --------------------------------------------------------
    # Если GitHub сейчас действительно не содержит
    # sources_soundcloud.py, пробуем локальный модуль.
    # --------------------------------------------------------

    if module_source is None:

        local = check_local_module()

        if local is not None:

            module_source = local
            module_origin = (
                "локальный sources_soundcloud.py"
            )

            print(
                "\n  Найден существующий "
                "рабочий локальный SoundCloud-модуль."
            )

    # --------------------------------------------------------
    # Дополнительный поиск
    # --------------------------------------------------------

    if module_source is None:

        local_candidates = (
            find_local_soundcloud_sources()
        )

        if local_candidates:

            path, module_source = (
                local_candidates[0]
            )

            module_origin = (
                f"локальный файл: {path.name}"
            )

            print(
                "\n  Найден SoundCloud-модуль:"
            )

            print(
                f"  {path}"
            )

    # --------------------------------------------------------
    # Ничего не найдено
    # --------------------------------------------------------

    if module_source is None:

        fail(
            "\nНе удалось получить полноценный "
            "sources_soundcloud.py.\n\n"
            "GitHub-файл downloader.py импортирует "
            "sources_soundcloud.py, но сам модуль "
            "по указанному адресу сейчас отсутствует.\n\n"
            "Патч специально остановлен ДО изменения "
            "downloader.py, чтобы не повредить рабочий файл."
        )

    print(
        "\n  Источник SoundCloud:"
    )

    print(
        f"  {module_origin}"
    )

    # --------------------------------------------------------
    # 3
    # --------------------------------------------------------

    print(
        "\n3/8: проверка SoundCloud-модуля..."
    )

    valid, missing = (
        validate_soundcloud_module_text(
            module_source,
            "полученный SoundCloud-модуль"
        )
    )

    if not valid:

        fail(
            "SoundCloud-модуль неполный:\n"
            + "\n".join(
                "  - " + name
                for name in missing
            )
        )

    # --------------------------------------------------------
    # Создаём временный файл и компилируем его
    # ДО изменения рабочего sources_soundcloud.py.
    # --------------------------------------------------------

    temp_module = (
        ENGINE_DIR
        / (
            ".sources_soundcloud."
            "validation_tmp.py"
        )
    )

    try:

        write_text(
            temp_module,
            module_source
        )

        py_compile.compile(
            str(temp_module),
            doraise=True
        )

    finally:

        try:

            if temp_module.exists():
                temp_module.unlink()

        except Exception:
            pass

    print(
        "  OK: синтаксис SoundCloud-модуля"
    )

    # --------------------------------------------------------
    # 4
    # --------------------------------------------------------

    print(
        "\n4/8: создание резервных копий..."
    )

    downloader_backup = (
        create_backup()
    )

    module_backup = (
        create_module_backup()
    )

    print(
        "  Backup downloader.py:"
    )

    print(
        f"  {downloader_backup}"
    )

    if module_backup:

        print(
            "  Backup sources_soundcloud.py:"
        )

        print(
            f"  {module_backup}"
        )

    # --------------------------------------------------------
    # 5
    # --------------------------------------------------------

    print(
        "\n5/8: установка "
        "sources_soundcloud.py..."
    )

    write_text(
        SOUNDCLOUD_MODULE,
        module_source
    )

    py_compile.compile(
        str(SOUNDCLOUD_MODULE),
        doraise=True
    )

    print(
        "  OK"
    )

    # --------------------------------------------------------
    # 6
    # --------------------------------------------------------

    print(
        "\n6/8: проверка/исправление "
        "импорта в downloader.py..."
    )

    try:

        new_downloader = (
            ensure_soundcloud_import(
                current_source
            )
        )

        write_text(
            DOWNLOADER,
            new_downloader
        )

        print(
            "  OK: top-level import"
        )

    except Exception:

        print(
            "  Ошибка. Выполняю откат..."
        )

        shutil.copy2(
            downloader_backup,
            DOWNLOADER
        )

        if module_backup:

            shutil.copy2(
                module_backup,
                SOUNDCLOUD_MODULE
            )

        else:

            try:

                SOUNDCLOUD_MODULE.unlink()

            except FileNotFoundError:
                pass

        raise

    # --------------------------------------------------------
    # 7
    # --------------------------------------------------------

    print(
        "\n7/8: проверка downloader.py..."
    )

    try:

        final_downloader = read_text(
            DOWNLOADER
        )

        py_compile.compile(
            str(DOWNLOADER),
            doraise=True
        )

        validate_final_downloader(
            final_downloader
        )

        print(
            "  OK: downloader.py"
        )

        validate_final_module()

        print(
            "  OK: sources_soundcloud.py"
        )

    except Exception:

        print(
            "\n  Ошибка проверки."
        )

        print(
            "  Выполняю полный откат..."
        )

        shutil.copy2(
            downloader_backup,
            DOWNLOADER
        )

        if module_backup:

            shutil.copy2(
                module_backup,
                SOUNDCLOUD_MODULE
            )

        else:

            try:

                SOUNDCLOUD_MODULE.unlink()

            except FileNotFoundError:
                pass

        print(
            "  Backup восстановлен."
        )

        raise

    # --------------------------------------------------------
    # 8
    # --------------------------------------------------------

    print(
        "\n8/8: финальная проверка..."
    )

    py_compile.compile(
        str(DOWNLOADER),
        doraise=True
    )

    py_compile.compile(
        str(SOUNDCLOUD_MODULE),
        doraise=True
    )

    final_downloader = read_text(
        DOWNLOADER
    )

    validate_final_downloader(
        final_downloader
    )

    validate_final_module()

    print(
        "  OK"
    )

    print(
        "\n" + "=" * 70
    )

    print(
        "SOUNDCLOUD-ПЕРЕНОС УСПЕШНО ЗАВЕРШЁН"
    )

    print(
        "=" * 70
    )

    print(
        "\nУстановлен:"
    )

    print(
        "  " + str(SOUNDCLOUD_MODULE)
    )

    print(
        "\nИсточник:"
    )

    print(
        f"  {module_origin}"
    )

    print(
        "\nBackup downloader.py:"
    )

    print(
        f"  {downloader_backup}"
    )

    if module_backup:

        print(
            "\nBackup старого sources_soundcloud.py:"
        )

        print(
            f"  {module_backup}"
        )


# ============================================================
# Запуск
# ============================================================


if __name__ == "__main__":

    try:

        main()

    except Exception as error:

        print(
            "\n" + "=" * 70
        )

        print(
            "ОШИБКА ПРИ ВОССТАНОВЛЕНИИ SOUNDCLOUD"
        )

        print(
            "=" * 70
        )

        print(
            f"{type(error).__name__}: {error}"
        )

        sys.exit(1)
