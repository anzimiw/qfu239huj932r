def backup_file(path):
    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    backup = (
        path
        + ".backup_"
        + timestamp
    )

    shutil.copy2(
        path,
        backup
    )

    return backup


def replace_function(
    text,
    function_name,
    new_function
):
    pattern = re.compile(
        r"(?ms)^def "
        + re.escape(function_name)
        + r"\s*\(.*?"
        r"(?=^def |\Z)"
    )

    match = pattern.search(text)

    if not match:
        raise RuntimeError(
            "Не найдена функция: "
            + function_name
        )

    return (
        text[:match.start()]
        + new_function.rstrip()
        + "\n"
        + text[match.end():]
    )


