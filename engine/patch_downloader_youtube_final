def fail(message):
    print()
    print("=" * 70)
    print("ОШИБКА ПРИ ПАТЧЕ")
    print("=" * 70)
    print()
    print(message)
    print()
    raise SystemExit(1)


def find_function_node(tree, name):
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            if node.name == name:
                return node
    return None


def replace_function(source, tree, function_name, new_function_text):
    node = find_function_node(tree, function_name)

    if node is None:
        fail(
            f"Не найдена функция {function_name}()."
        )

    lines = source.splitlines(True)

    start = node.lineno - 1

    if node.end_lineno is None:
        fail(
            f"Не удалось определить конец функции "
            f"{function_name}()."
        )

    end = node.end_lineno

    replacement = (
        new_function_text.rstrip()
        + "\n"
    )

    return (
        "".join(lines[:start])
        + replacement
        + "".join(lines[end:])
    )


def check_syntax(path):
    try:
        with open(
            path,
            "r",
            encoding="utf-8-sig"
        ) as f:
            text = f.read()

        ast.parse(text, filename=path)
        return True, None

    except SyntaxError as e:
        return False, e


