import ast
import os
import py_compile
import shutil
import sys
from datetime import datetime


ENGINE_DIR = os.path.dirname(
    os.path.abspath(__file__)
)

DOWNLOADER = os.path.join(
    ENGINE_DIR,
    "downloader.py"
)

SOUNDCLOUD_MODULE = os.path.join(
    ENGINE_DIR,
    "sources_soundcloud.py"
)

MAX_SOUNDCLOUD_CANDIDATES = 5


def fail(message):
    raise RuntimeError(message)


def read_text(path):
    with open(
        path,
        "r",
        encoding="utf-8"
    ) as f:
        return f.read()


def write_text(path, text):
    with open(
        path,
        "w",
        encoding="utf-8",
        newline=""
    ) as f:
        f.write(text)


def parse(source, label):
    try:
        return ast.parse(source)
    except SyntaxError as error:
        fail(
            f"{label} содержит синтаксическую ошибку:\n"
            f"{error}"
        )


def top_functions(tree):
    return {
        node.name: node
        for node in tree.body
        if isinstance(
            node,
            (
                ast.FunctionDef,
                ast.AsyncFunctionDef
            )
        )
    }


def make_backup(path):
    stamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    backup = os.path.join(
        ENGINE_DIR,
        os.path.basename(path)
        + ".backup_next_candidates_"
        + stamp
    )

    shutil.copy2(
        path,
        backup
    )

    return backup


def patch_sources_soundcloud(source):

    if '"alternatives"' in source:
        fail(
            "sources_soundcloud.py уже содержит "
            "alternatives. Патч уже применён "
            "или файл уже изменён."
        )

    tree = parse(
        source,
        "sources_soundcloud.py"
    )

    funcs = top_functions(tree)

    if "search_soundcloud" not in funcs:
        fail(
            "Функция search_soundcloud() "
            "не найдена."
        )

    old = '''        print(
            "SoundCloud: используем результат "
            f"этапа {stage_number}."
        )
        return {
            "url": candidate_url,
            "title": candidate_title,
            "artist": candidate_artist,
            "duration": candidate.get(
                "duration"
            ),
            "score": best["score"],
            "candidate": candidate,
            "search_stage": stage_number,
            "search_query": query,
            # Признак очень точного совпадения.
            #
            # Для exact_match НЕ используются конкретные
            # имена исполнителей или названия треков.
            #
            # Проверяем:
            #   1. высокий score;
            #   2. точное совпадение названия;
            #   3. совпадение исполнителя.
            "exact_match": (
                best["score"] >= 900
                and (
                    best.get("title_ratio", 0)
                    >= 1.0
                )
                and (
                    best.get("artist_ratio", 0)
                    >= 1.0
                )
            ),
        }
'''

    new = '''        print(
            "SoundCloud: используем результат "
            f"этапа {stage_number}."
        )

        # ----------------------------------------------------
        # СОХРАНЯЕМ СЛЕДУЮЩИЕ КАНДИДАТЫ
        #
        # ВАЖНО:
        # существующий scoring НЕ изменяется.
        #
        # candidates уже отсортированы:
        #
        #   candidates[0] = TOP 1
        #   candidates[1] = TOP 2
        #   candidates[2] = TOP 3
        #   ...
        #
        # Мы только передаём следующие кандидаты downloader'у.
        # ----------------------------------------------------

        alternatives = []

        for alternative_item in candidates[
            1:MAX_SOUNDCLOUD_CANDIDATES
        ]:

            alternative_candidate = (
                alternative_item["candidate"]
            )

            alternative_title = str(
                alternative_candidate.get(
                    "title"
                )
                or ""
            ).strip()

            alternative_user = (
                alternative_candidate.get(
                    "user"
                )
            )

            if isinstance(
                alternative_user,
                dict
            ):
                alternative_artist = str(
                    alternative_user.get(
                        "username"
                    )
                    or ""
                ).strip()
            else:
                alternative_artist = ""

            alternative_url = (
                alternative_candidate.get(
                    "permalink_url"
                )
                or alternative_candidate.get(
                    "uri"
                )
                or ""
            )

            if not alternative_url:
                continue

            alternatives.append({
                "url": alternative_url,
                "title": alternative_title,
                "artist": alternative_artist,
                "duration": alternative_candidate.get(
                    "duration"
                ),
                "score": alternative_item["score"],
                "candidate": alternative_candidate,
                "search_stage": stage_number,
                "search_query": query,
                "exact_match": (
                    alternative_item["score"] >= 900
                    and (
                        alternative_item.get(
                            "title_ratio",
                            0
                        ) >= 1.0
                    )
                    and (
                        alternative_item.get(
                            "artist_ratio",
                            0
                        ) >= 1.0
                    )
                ),
            })

        return {
            "url": candidate_url,
            "title": candidate_title,
            "artist": candidate_artist,
            "duration": candidate.get(
                "duration"
            ),
            "score": best["score"],
            "candidate": candidate,
            "search_stage": stage_number,
            "search_query": query,
            # Признак очень точного совпадения.
            #
            # Для exact_match НЕ используются конкретные
            # имена исполнителей или названия треков.
            #
            # Проверяем:
            #   1. высокий score;
            #   2. точное совпадение названия;
            #   3. совпадение исполнителя.
            "exact_match": (
                best["score"] >= 900
                and (
                    best.get("title_ratio", 0)
                    >= 1.0
                )
                and (
                    best.get("artist_ratio", 0)
                    >= 1.0
                )
            ),

            # Следующие кандидаты в том же порядке,
            # который уже определён существующим scoring.
            "alternatives": alternatives,
        }
'''

    if old not in source:
        fail(
            "Не найден точный блок возврата результата "
            "в search_soundcloud().\n\n"
            "Это означает, что файл на ПК отличается "
            "от актуального sources_soundcloud.py "
            "на GitHub."
        )

    return source.replace(
        old,
        new,
        1
    )


def patch_downloader(source):

    tree = parse(
        source,
        "downloader.py"
    )

    funcs = top_functions(tree)

    if "find_and_download_track" not in funcs:
        fail(
            "Функция find_and_download_track() "
            "не найдена."
        )

    if "soundcloud_candidates" in source:
        fail(
            "downloader.py уже содержит "
            "soundcloud_candidates. "
            "Патч уже применён."
        )

    old = '''    if result and download_from_soundcloud(
        result["url"],
        filepath,
        duration,
        result.get(
            "exact_match",
            False
        )
    ):
        return filepath
'''

    new = '''    if result:

        # ----------------------------------------------------
        # ПОСЛЕДОВАТЕЛЬНАЯ ПРОВЕРКА SOUNDCLOUD
        #
        # search_soundcloud() сохраняет существующий
        # scoring и порядок кандидатов.
        #
        # Здесь меняется только поведение после поиска:
        #
        # TOP 1
        #   ↓
        # фактическая загрузка
        #   ↓
        # длительность неправильная?
        #   ↓
        # TOP 2
        #   ↓
        # TOP 3
        #   ↓
        # ...
        #
        # Максимум проверяем 5 кандидатов.
        # ----------------------------------------------------

        soundcloud_candidates = [
            result
        ]

        alternatives = result.get(
            "alternatives",
            []
        )

        if isinstance(
            alternatives,
            list
        ):
            soundcloud_candidates.extend(
                alternatives
            )

        soundcloud_candidates = (
            soundcloud_candidates[
                :MAX_SOUNDCLOUD_CANDIDATES
            ]
        )

        print(
            "SoundCloud: кандидатов "
            "для последовательной проверки: "
            f"{len(soundcloud_candidates)}"
        )

        for candidate_index, candidate_result in enumerate(
            soundcloud_candidates,
            1
        ):

            print()
            print(
                "SoundCloud: проверка кандидата "
                f"{candidate_index}/"
                f"{len(soundcloud_candidates)}"
            )

            print(
                "SoundCloud: score: "
                f"{candidate_result.get('score', 0):.1f}"
            )

            print(
                "SoundCloud: название кандидата: "
                f"{candidate_result.get('title', '')}"
            )

            print(
                "SoundCloud: исполнитель кандидата: "
                f"{candidate_result.get('artist', '')}"
            )

            candidate_url = candidate_result.get(
                "url"
            )

            if not candidate_url:
                print(
                    "SoundCloud: у кандидата "
                    "отсутствует URL. Пропуск."
                )
                continue

            if download_from_soundcloud(
                candidate_url,
                filepath,
                duration,
                candidate_result.get(
                    "exact_match",
                    False
                )
            ):
                print(
                    "SoundCloud: кандидат "
                    f"{candidate_index} подходит."
                )
                return filepath

            print(
                "SoundCloud: кандидат "
                f"{candidate_index} не подошёл."
            )

        print(
            "SoundCloud: все проверенные "
            "кандидаты не подошли."
        )

        print(
            "SoundCloud: переход к MP3Party."
        )
'''

    if old not in source:
        fail(
            "Не найден текущий блок загрузки SoundCloud "
            "в find_and_download_track()."
        )

    return source.replace(
        old,
        new,
        1
    )


def validate_sources(source):

    tree = parse(
        source,
        "sources_soundcloud.py"
    )

    funcs = top_functions(tree)

    if "search_soundcloud" not in funcs:
        fail(
            "search_soundcloud() отсутствует."
        )

    if '"alternatives"' not in source:
        fail(
            "После изменения поле alternatives "
            "не найдено."
        )


def validate_downloader(source):

    tree = parse(
        source,
        "downloader.py"
    )

    funcs = top_functions(tree)

    if "find_and_download_track" not in funcs:
        fail(
            "find_and_download_track() отсутствует."
        )

    if "soundcloud_candidates" not in source:
        fail(
            "После изменения блок "
            "soundcloud_candidates не найден."
        )


def main():

    print("=" * 70)
    print(
        "CENSURU.NET — SOUNDCLOUD "
        "NEXT CANDIDATES V3"
    )
    print("=" * 70)

    if not os.path.isfile(
        SOUNDCLOUD_MODULE
    ):
        fail(
            "Не найден sources_soundcloud.py:\n"
            + SOUNDCLOUD_MODULE
        )

    if not os.path.isfile(
        DOWNLOADER
    ):
        fail(
            "Не найден downloader.py:\n"
            + DOWNLOADER
        )

    print(
        "\n1/8: проверка текущих файлов..."
    )

    sources_original = read_text(
        SOUNDCLOUD_MODULE
    )

    downloader_original = read_text(
        DOWNLOADER
    )

    parse(
        sources_original,
        "sources_soundcloud.py"
    )

    parse(
        downloader_original,
        "downloader.py"
    )

    print(
        "  OK: синтаксис."
    )

    print(
        "\n2/8: проверка структуры..."
    )

    sources_tree = parse(
        sources_original,
        "sources_soundcloud.py"
    )

    downloader_tree = parse(
        downloader_original,
        "downloader.py"
    )

    if "search_soundcloud" not in top_functions(
        sources_tree
    ):
        fail(
            "search_soundcloud() не найдена."
        )

    if "find_and_download_track" not in top_functions(
        downloader_tree
    ):
        fail(
            "find_and_download_track() не найдена."
        )

    if '"alternatives"' in sources_original:
        fail(
            "В sources_soundcloud.py уже присутствует "
            "alternatives. Патч повторно не применяется."
        )

    if "soundcloud_candidates" in downloader_original:
        fail(
            "В downloader.py уже присутствует "
            "soundcloud_candidates. Патч повторно не применяется."
        )

    print(
        "  OK: исходные версии подходят."
    )

    print(
        "\n3/8: создание резервных копий..."
    )

    backup_sources = make_backup(
        SOUNDCLOUD_MODULE
    )

    backup_downloader = make_backup(
        DOWNLOADER
    )

    print(
        "  Backup sources_soundcloud.py:"
    )
    print(
        "  " + backup_sources
    )

    print(
        "  Backup downloader.py:"
    )
    print(
        "  " + backup_downloader
    )

    try:

        print(
            "\n4/8: изменение "
            "sources_soundcloud.py..."
        )

        sources_patched = (
            patch_sources_soundcloud(
                sources_original
            )
        )

        write_text(
            SOUNDCLOUD_MODULE,
            sources_patched
        )

        print(
            "  OK."
        )

        print(
            "\n5/8: проверка "
            "sources_soundcloud.py..."
        )

        py_compile.compile(
            SOUNDCLOUD_MODULE,
            doraise=True
        )

        validate_sources(
            sources_patched
        )

        print(
            "  OK: синтаксис и структура."
        )

        print(
            "\n6/8: изменение downloader.py..."
        )

        downloader_patched = (
            patch_downloader(
                downloader_original
            )
        )

        write_text(
            DOWNLOADER,
            downloader_patched
        )

        print(
            "  OK."
        )

        print(
            "\n7/8: проверка downloader.py..."
        )

        py_compile.compile(
            DOWNLOADER,
            doraise=True
        )

        validate_downloader(
            downloader_patched
        )

        print(
            "  OK: синтаксис и структура."
        )

        print(
            "\n8/8: финальная проверка..."
        )

        py_compile.compile(
            SOUNDCLOUD_MODULE,
            doraise=True
        )

        py_compile.compile(
            DOWNLOADER,
            doraise=True
        )

        print(
            "  OK: оба файла успешно "
            "компилируются."
        )

    except Exception:

        print(
            "\nОШИБКА: выполняю полный откат..."
        )

        shutil.copy2(
            backup_sources,
            SOUNDCLOUD_MODULE
        )

        shutil.copy2(
            backup_downloader,
            DOWNLOADER
        )

        print(
            "  sources_soundcloud.py восстановлен."
        )

        print(
            "  downloader.py восстановлен."
        )

        raise

    print()
    print("=" * 70)
    print(
        "ПАТЧ УСПЕШНО ПРИМЕНЁН"
    )
    print("=" * 70)

    print()
    print(
        "SoundCloud теперь может проверить "
        "до 5 лучших кандидатов."
    )

    print(
        "Существующий scoring НЕ изменён."
    )

    print(
        "evaluate_soundcloud_candidate() "
        "НЕ изменён."
    )

    print(
        "Каскад поиска 1/4 -> 4/4 "
        "НЕ изменён."
    )

    print()
    print(
        "Backup sources_soundcloud.py:"
    )
    print(
        backup_sources
    )

    print(
        "Backup downloader.py:"
    )
    print(
        backup_downloader
    )


if __name__ == "__main__":

    try:
        main()

    except Exception as error:

        print()
        print("=" * 70)
        print(
            "ОШИБКА ПРИ ИЗМЕНЕНИИ SOUNDCLOUD"
        )
        print("=" * 70)

        print(
            f"{type(error).__name__}: "
            f"{error}"
        )

        sys.exit(1)
