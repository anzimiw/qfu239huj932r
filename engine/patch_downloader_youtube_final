    """

    print()
    print(
        "YouTube fallback: "
        "поиск трека по метаданным..."
    )

    query = (
        f"{artist} {title}"
    ).strip()

    if not query:
        print(
            "YouTube fallback: "
            "пустой поисковый запрос."
        )
        return None

    print(
        "YouTube fallback: "
        f"поисковый запрос: {query}"
    )

    command = [
        YTDLP,
        "--dump-single-json",
        "--flat-playlist",
        "--playlist-end",
        "5",
        "--quiet",
        "--no-warnings",
        f"ytsearch5:{query}"
    ]

    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=60
        )

    except subprocess.TimeoutExpired:
        print(
            "YouTube fallback: "
            "поиск превысил лимит 60 секунд."
        )
        return None

    except Exception as e:
        print(
            "YouTube fallback: "
            f"ошибка поиска: {e}"
        )
        return None

    if result.returncode != 0:
        print(
            "YouTube fallback: "
            "yt-dlp не смог выполнить поиск."
        )

        if result.stderr:
            error_text = (
                result.stderr.strip()
            )

            if error_text:
                print(
                    "YouTube fallback: "
                    f"{error_text[:500]}"
                )

        return None

    stdout = (
        result.stdout.strip()
        if result.stdout
        else ""
    )

    if not stdout:
        print(
            "YouTube fallback: "
            "поиск не вернул результатов."
        )
        return None

    try:
        data = json.loads(
            stdout
        )
    except Exception:
        print(
            "YouTube fallback: "
            "не удалось разобрать JSON поиска."
        )
        return None

    entries = (
        data.get("entries")
        if isinstance(data, dict)
        else None
    )

    if not isinstance(
        entries,
        list
    ):
        entries = []

    if not entries:
        print(
            "YouTube fallback: "
            "кандидаты не найдены."
        )
        return None

    target_artist = normalize(
        artist
    )

    target_title = normalize(
        title
    )

    target_words = (
        normalize_words(title)
    )

    artist_words = (
        normalize_words(artist)
    )

    candidates = []

    for index, entry in enumerate(
        entries,
        1
    ):
        if not isinstance(
            entry,
            dict
        ):
            continue

        video_id = (
            entry.get("id")
            or ""
        )

        if not video_id:
            continue

        candidate_url = (
            entry.get("webpage_url")
            or entry.get("url")
        )

        if (
            not candidate_url
            or not str(candidate_url).startswith(
                "http"
            )
        ):
            candidate_url = (
                "https://www.youtube.com/watch?v="
                + str(video_id)
            )

        candidate_title = (
            entry.get("title")
            or ""
        )

        candidate_artist = (
            entry.get("uploader")
            or entry.get("channel")
            or entry.get("artist")
            or ""
        )

        candidate_duration = (
            entry.get("duration")
        )

        normalized_title = normalize(
            candidate_title
        )

        normalized_artist = normalize(
            candidate_artist
        )

        candidate_words = (
            normalize_words(
                candidate_title
            )
        )

        score = 0

        # Совпадение слов названия.
        if target_words:
            title_ratio = (
                len(
                    target_words
                    & candidate_words
                )
                / len(target_words)
            )

            if title_ratio >= 1:
                score += 500
            elif title_ratio >= 0.75:
                score += 350
            elif title_ratio >= 0.5:
                score += 150
            else:
                score -= 500

        # Совпадение слов исполнителя.
        if artist_words:
            artist_ratio = (
                len(
                    artist_words
                    & normalize_words(
                        candidate_artist
                    )
                )
                / len(artist_words)
            )

            if artist_ratio >= 1:
                score += 400
            elif artist_ratio >= 0.75:
                score += 250
            elif artist_ratio >= 0.5:
                score += 100
            else:
                score -= 300

        # Прямое совпадение названия.
        if (
            target_title
            and target_title
            in normalized_title
        ):
            score += 400

        # Прямое совпадение исполнителя.
        if (
            target_artist
            and target_artist
            in normalized_artist
        ):
            score += 300

        # Проверка длительности.
        duration_ok = True
        duration_difference = None

        if (
            candidate_duration is not None
            and target_duration is not None
        ):
            try:
                duration_difference = abs(
                    float(candidate_duration)
                    - float(target_duration)
                )

                if duration_difference <= 5:
                    score += 500
                elif duration_difference <= 10:
                    score += 250
                elif duration_difference <= 30:
                    score += 50
                else:
                    score -= 500
                    duration_ok = False

            except Exception:
                pass

        print()
        print(
            "YouTube fallback: "
            f"кандидат {index}:"
        )

        print(
            "  название: "
            f"{candidate_title}"
        )

        print(
            "  исполнитель: "
            f"{candidate_artist}"
        )

        print(
            "  длительность: "
            f"{candidate_duration}"
        )

        if duration_difference is not None:
            print(
                "  отличие по длительности: "
                f"{duration_difference:.1f} сек."
            )

        print(
            "  score: "
            f"{score}"
        )

        candidates.append(
            {
                "url": candidate_url,
                "title": candidate_title,
                "artist": candidate_artist,
                "duration": candidate_duration,
                "score": score,
                "duration_ok": duration_ok
            }
        )

    candidates.sort(
        key=lambda x: x["score"],
        reverse=True
    )

    # Сначала выбираем только кандидата,
    # который прошёл проверку длительности.
    for candidate in candidates:
        if (
            candidate["score"] >= 300
            and candidate["duration_ok"]
        ):
            print()
            print(
                "YouTube fallback: "
                "подходящий кандидат найден."
            )

            print(
                "YouTube fallback: "
                f"название: {candidate['title']}"
            )

            print(
                "YouTube fallback: "
                f"исполнитель: {candidate['artist']}"
            )

            print(
                "YouTube fallback: "
                f"score: {candidate['score']}"
            )

            print(
                "YouTube fallback: "
                f"URL: {candidate['url']}"
            )

            return candidate["url"]

    print()
    print(
        "YouTube fallback: "
        "подходящий кандидат не найден."
    )

    return None

'''


def patch_find_and_download(lines):
    start = find_function(
        lines,
        "find_and_download_track"
    )

    if start is None:
        raise RuntimeError(
            "Не найдена функция "
            "find_and_download_track()."
        )

    end = find_function_end(
        lines,
        start
    )

    block = "".join(
        lines[start:end]
    )

    marker = (
        "    # 5. YouTube / yt-dlp"
    )

    if marker not in block:
        raise RuntimeError(
            "В find_and_download_track() "
            "не найден текущий блок "
            "YouTube fallback."
        )

    old_start = block.index(
        marker
    )

    old_end_marker = (
        '    print(\n'
        '        "Не удалось скачать "\n'
    )

    old_end = block.find(
        old_end_marker,
        old_start
    )

    if old_end < 0:
        raise RuntimeError(
            "Не найден конец блока "
            "YouTube fallback."
        )

    # Находим конец финального print(...)
    # перед return None.
    return_marker = (
        "\n    return None"
    )

    return_pos = block.find(
        return_marker,
        old_end
    )

    if return_pos < 0:
        raise RuntimeError(
            "Не найден return None "
            "в find_and_download_track()."
        )

    old_fallback_end = (
        return_pos
    )

    new_fallback = r'''    # 5. YouTube / yt-dlp
    #
    # Правила:
    #
    # 1. Если исходная ссылка была YouTube:
    #    используем её напрямую.
    #
    # 2. Если исходный YouTube ранее сообщил
    #    age restriction:
    #    прямой fallback запрещён.
    #
    # 3. Если исходник НЕ YouTube
    #    (например Яндекс Музыка):
    #    сначала ищем подходящий трек
    #    непосредственно в YouTube.
    #
    # 4. Preview SoundCloud сам по себе
    #    не запрещает этот fallback.
    #
    # 5. Сначала выбирается подходящий
    #    YouTube-кандидат по метаданным,
    #    затем существующий download_with_ytdlp()
    #    скачивает выбранный URL.

    print()
    print(
        "YouTube fallback: "
        "проверка финального этапа..."
    )

    print(
        "YouTube fallback: "
        f"source = {source!r}"
    )

    print(
        "YouTube fallback: "
        f"source_url = {source_url!r}"
    )

    print(
        "YouTube fallback: "
        f"LAST_YOUTUBE_ERROR = "
        f"{LAST_YOUTUBE_ERROR!r}"
    )

    youtube_age_restricted = (
        source == "youtube"
        and is_youtube_age_error(
            LAST_YOUTUBE_ERROR
        )
    )

    if youtube_age_restricted:
        print(
            "YouTube fallback: "
            "скачивание пропущено."
        )

        print(
            "Причина: YouTube ранее "
            "запросил подтверждение возраста."
        )

    else:
        youtube_fallback_url = None

        if (
            source == "youtube"
            and source_url
        ):
            print(
                "YouTube fallback: "
                "используется исходная "
                "YouTube-ссылка."
            )

            youtube_fallback_url = (
                source_url
            )

        elif source != "youtube":
            print(
                "YouTube fallback: "
                "исходник не является YouTube."
            )

            print(
                "YouTube fallback: "
                "поиск подходящего видео "
                "по метаданным..."
            )

            youtube_fallback_url = (
                find_youtube_fallback_url(
                    artist,
                    title,
                    duration
                )
            )

        if youtube_fallback_url:
            print(
                "YouTube fallback: "
                "запуск yt-dlp..."
            )

            print(
                "YouTube fallback: "
                f"URL: {youtube_fallback_url}"
            )

            if download_with_ytdlp(
                youtube_fallback_url,
                filepath
            ):
                print(
                    "YouTube fallback: "
                    "аудиофайл успешно получен."
                )

                return filepath

            print(
                "YouTube fallback: "
                "yt-dlp не смог скачать "
                "выбранный аудиофайл."
            )

        else:
            print(
                "YouTube fallback: "
                "подходящая ссылка "
                "для скачивания не найдена."
            )

    print(
        "Не удалось скачать "
        "подходящий аудиофайл."
    )

    return None
'''

    new_block = (
        block[:old_start]
        + new_fallback
    )

    lines[start:end] = (
        new_block.splitlines(
            keepends=True
        )
    )


