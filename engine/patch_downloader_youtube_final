def fail(message):
    raise RuntimeError(message)


def read_text(path):
    with open(path, "r", encoding="utf-8") as f:
        return f.read()


def write_text(path, text):
    with open(path, "w", encoding="utf-8", newline="") as f:
        f.write(text)


def parse(source, label="source"):
    try:
        return ast.parse(source)
    except SyntaxError as e:
        fail(f"{label} содержит синтаксическую ошибку:\n{e}")


def top_functions(tree):
    return {
        n.name: n
        for n in tree.body
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
    }


def top_assignments(tree):
    result = {}

    for n in tree.body:
        if isinstance(n, ast.Assign):
            for target in n.targets:
                if isinstance(target, ast.Name):
                    result[target.id] = n

        elif isinstance(n, ast.AnnAssign):
            if isinstance(n.target, ast.Name):
                result[n.target.id] = n

    return result


def node_source(source, node):
    lines = source.splitlines(keepends=True)
    return "".join(
        lines[node.lineno - 1:node.end_lineno]
    )


def build_module(source, tree):
    funcs = top_functions(tree)
    assigns = top_assignments(tree)

    out = [
        "# Censuru.net — SoundCloud source\n",
        "# Реальная рабочая логика перенесена из downloader.py.\n\n",
        "import os\n",
        "import re\n",
        "import html\n",
        "import shutil\n",
        "import subprocess\n",
        "import requests\n",
        "from urllib.parse import unquote\n\n",
    ]

    # ---------------------------------------------------------
    # Перенос обязательных констант
    # ---------------------------------------------------------

    for name in REQUIRED_CONSTANTS:

        node = assigns.get(name)

        if node is not None:
            out.append(
                node_source(source, node).strip() + "\n\n"
            )

        elif name == "SOUNDCLOUD_CLIENT_ID_CACHE":
            out.append(
                "SOUNDCLOUD_CLIENT_ID_CACHE = None\n\n"
            )

        elif name in DEFAULTS:
            out.append(
                f"{name} = {DEFAULTS[name]}\n\n"
            )

        else:
            fail(
                f"Не найден обязательный SoundCloud-параметр: {name}"
            )

    # ---------------------------------------------------------
    # Проверка обязательных зависимостей
    # ---------------------------------------------------------

    if "HEADERS" not in assigns:
        fail(
            "Не найден обязательный общий параметр HEADERS "
            "для SoundCloud"
        )

    # ---------------------------------------------------------
    # Перенос функций
    # ---------------------------------------------------------

    for name in MOVE_FUNCTIONS:

        node = funcs.get(name)

        if node is None:
            fail(
                f"Функция {name} не найдена в исходном downloader.py"
            )

        out.append(
            node_source(source, node).rstrip() + "\n\n"
        )

    return "".join(out)


def remove_functions(source, tree):
    funcs = top_functions(tree)
    lines = source.splitlines(keepends=True)

    nodes = []

    for name in MOVE_FUNCTIONS:
        if name not in funcs:
            fail(
                f"Невозможно удалить функцию {name}: "
                "она отсутствует в исходном файле."
            )

        nodes.append(funcs[name])

    nodes.sort(
        key=lambda n: n.lineno,
        reverse=True
    )

    for node in nodes:
        del lines[
            node.lineno - 1:
            node.end_lineno
        ]

    return "".join(lines)


def add_import_safely(source):
    """
    Добавляет top-level import sources_soundcloud.

    Импорт никогда не вставляется внутрь try/except,
    функции или другого блока.
    """

    if "from sources_soundcloud import (" in source:
        return source

    tree = parse(
        source,
        "downloader.py перед добавлением импорта"
    )

    lines = source.splitlines(keepends=True)

    top_imports = [
        n
        for n in tree.body
        if isinstance(
            n,
            (ast.Import, ast.ImportFrom)
        )
    ]

    import_block = (
        "\n"
        "from sources_soundcloud import (\n"
        "    get_soundcloud_client_id,\n"
        "    normalize_soundcloud_metadata,\n"
        "    evaluate_soundcloud_candidate,\n"
        "    fetch_soundcloud_results,\n"
        "    search_soundcloud,\n"
        "    download_from_soundcloud,\n"
        ")\n"
    )

    if top_imports:
        insert_line = max(
            n.end_lineno
            for n in top_imports
        )

        lines.insert(
            insert_line,
            import_block
        )

        return "".join(lines)

    return (
        import_block.lstrip("\n")
        + "\n"
        + source
    )


def validate_downloader(source):
    tree = parse(
        source,
        "изменённый downloader.py"
    )

    funcs = top_functions(tree)

    for name in MOVE_FUNCTIONS:

        if name in funcs:
            fail(
                "Функция всё ещё находится "
                f"в downloader.py: {name}"
            )

    if "from sources_soundcloud import (" not in source:
        fail(
            "Импорт sources_soundcloud "
            "не найден в downloader.py"
        )

    import_nodes = [
        n
        for n in tree.body
        if isinstance(n, ast.ImportFrom)
        and n.module == "sources_soundcloud"
    ]

    if len(import_nodes) != 1:
        fail(
            "Ожидался ровно один top-level "
            "import sources_soundcloud"
        )


def validate_module():
    if not os.path.isfile(SOUNDCLOUD_MODULE):
        fail(
            "sources_soundcloud.py не создан."
        )

    py_compile.compile(
        SOUNDCLOUD_MODULE,
        doraise=True
    )

    source = read_text(
        SOUNDCLOUD_MODULE
    )

    tree = parse(
        source,
        "sources_soundcloud.py"
    )

    funcs = top_functions(tree)

    for name in MOVE_FUNCTIONS:

        if name not in funcs:
            fail(
                "В sources_soundcloud.py отсутствует "
                f"{name}"
            )

    assignments = top_assignments(tree)

    if "HEADERS" not in assignments:
        fail(
            "В sources_soundcloud.py отсутствует HEADERS"
        )

    if "SOUNDCLOUD_HEADERS" not in assignments:
        fail(
            "В sources_soundcloud.py отсутствует "
            "SOUNDCLOUD_HEADERS"
        )


def backup_path():
    stamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    return os.path.join(
        ENGINE_DIR,
        f"downloader.py.backup_soundcloud_{stamp}"
    )


def find_soundcloud_backup():
    """
    Ищет backup downloader.py с исходным SoundCloud-блоком.

    Поддерживаются оба варианта:

        downloader.py.backup_*
        downloader.py.backup_soundcloud_*

    Каждая копия проверяется через AST.
    Используется самая свежая копия, содержащая
    все необходимые SoundCloud-функции.
    """

    patterns = (
        "downloader.py.backup_*",
        "downloader.py.backup_soundcloud_*",
    )

    candidates = {}

    for pattern in patterns:

        for path in Path(
            ENGINE_DIR
        ).glob(pattern):

            if path.is_file():

                resolved = str(
                    path.resolve()
                )

                candidates[resolved] = path

    backups = sorted(
        candidates.values(),
        key=lambda p: p.stat().st_mtime,
        reverse=True
    )

    if not backups:
        return None

    print(
        f"  Найдено резервных копий для проверки: "
        f"{len(backups)}"
    )

    for candidate in backups:

        try:

            candidate_source = read_text(
                str(candidate)
            )

            candidate_tree = parse(
                candidate_source,
                f"резервная копия {candidate.name}"
            )

            candidate_funcs = top_functions(
                candidate_tree
            )

            missing = [
                name
                for name in MOVE_FUNCTIONS
                if name not in candidate_funcs
            ]

            if not missing:

                print(
                    "  Подходящая резервная копия найдена:"
                )

                print(
                    f"  {candidate}"
                )

                return str(candidate)

        except Exception:
            continue

    return None


def main():

    print("=" * 70)
    print(
        "CENSURU.NET — ПЕРЕНОС SOUNDCLOUD "
        "(ИСПРАВЛЕННЫЙ V4)"
    )
    print("=" * 70)

    # ---------------------------------------------------------
    # Проверка downloader.py
    # ---------------------------------------------------------

    if not os.path.isfile(DOWNLOADER):
        fail(
            "Не найден downloader.py:\n"
            + DOWNLOADER
        )

    print(
        "\n1/8: проверка downloader.py..."
    )

    current = read_text(
        DOWNLOADER
    )

    current_tree = parse(
        current,
        "текущий downloader.py"
    )

    current_funcs = top_functions(
        current_tree
    )

    print(
        f"  OK: синтаксис. "
        f"Найдено функций: {len(current_funcs)}"
    )

    # ---------------------------------------------------------
    # Определяем источник SoundCloud
    # ---------------------------------------------------------

    missing = [
        name
        for name in MOVE_FUNCTIONS
        if name not in current_funcs
    ]

    source_path = DOWNLOADER

    if missing:

        print(
            "\n  SoundCloud-функции уже отсутствуют "
            "в текущем downloader.py."
        )

        print(
            "  Ищу резервную копию "
            "с исходным SoundCloud-блоком..."
        )

        source_path = find_soundcloud_backup()

        if source_path is None:

            fail(
                "Текущий downloader.py уже не содержит "
                "SoundCloud-функции, а подходящая "
                "резервная копия downloader.py.backup_* "
                "не найдена."
            )

    # ---------------------------------------------------------
    # Проверка найденного исходника
    # ---------------------------------------------------------

    original = read_text(
        source_path
    )

    tree = parse(
        original,
        f"исходник: {source_path}"
    )

    funcs = top_functions(
        tree
    )

    missing = [
        name
        for name in MOVE_FUNCTIONS
        if name not in funcs
    ]

    if missing:

        fail(
            "В выбранном исходнике отсутствуют "
            "SoundCloud-функции:\n"
            + "\n".join(
                "  - " + name
                for name in missing
            )
        )

    print(
        "\n  OK: источник для переноса:"
    )

    print(
        f"  {source_path}"
    )

    # ---------------------------------------------------------
    # Backup текущего downloader.py
    # ---------------------------------------------------------

    print(
        "\n2/8: создание резервной копии "
        "текущего downloader.py..."
    )

    backup = backup_path()

    shutil.copy2(
        DOWNLOADER,
        backup
    )

    print(
        "  Backup создан:"
    )

    print(
        "  " + backup
    )

    module_existed_before = os.path.isfile(
        SOUNDCLOUD_MODULE
    )

    module_backup = None

    if module_existed_before:

        stamp = datetime.now().strftime(
            "%Y%m%d_%H%M%S"
        )

        module_backup = os.path.join(
            ENGINE_DIR,
            f"sources_soundcloud.py.backup_{stamp}"
        )

        shutil.copy2(
            SOUNDCLOUD_MODULE,
            module_backup
        )

        print(
            "  Предыдущий sources_soundcloud.py "
            "также сохранён:"
        )

        print(
            "  " + module_backup
        )

    try:

        # -----------------------------------------------------
        # Создание SoundCloud-модуля
        # -----------------------------------------------------

        print(
            "\n3/8: построение "
            "sources_soundcloud.py..."
        )

        module = build_module(
            original,
            tree
        )

        write_text(
            SOUNDCLOUD_MODULE,
            module
        )

        py_compile.compile(
            SOUNDCLOUD_MODULE,
            doraise=True
        )

        print(
            "  OK: sources_soundcloud.py"
        )

        # -----------------------------------------------------
        # Удаление SoundCloud из downloader.py
        # -----------------------------------------------------

        print(
            "\n4/8: построение нового "
            "downloader.py без SoundCloud-функций..."
        )

        new_source = remove_functions(
            original,
            tree
        )

        # -----------------------------------------------------
        # Добавление импорта
        # -----------------------------------------------------

        print(
            "\n5/8: безопасная вставка "
            "top-level import..."
        )

        new_source = add_import_safely(
            new_source
        )

        write_text(
            DOWNLOADER,
            new_source
        )

        # -----------------------------------------------------
        # Проверка downloader.py
        # -----------------------------------------------------

        print(
            "\n6/8: проверка downloader.py..."
        )

        py_compile.compile(
            DOWNLOADER,
            doraise=True
        )

        validate_downloader(
            new_source
        )

        print(
            "  OK: синтаксис и структура"
        )

        # -----------------------------------------------------
        # Проверка SoundCloud-модуля
        # -----------------------------------------------------

        print(
            "\n7/8: повторная проверка "
            "sources_soundcloud.py..."
        )

        validate_module()

        print(
            "  OK: все SoundCloud-функции присутствуют"
        )

        # -----------------------------------------------------
        # Финальная проверка
        # -----------------------------------------------------

        print(
            "\n8/8: финальная проверка "
            "обоих файлов..."
        )

        py_compile.compile(
            DOWNLOADER,
            doraise=True
        )

        py_compile.compile(
            SOUNDCLOUD_MODULE,
            doraise=True
        )

        print(
            "  OK"
        )

    except Exception:

        print(
            "\nОШИБКА: выполняю полный откат..."
        )

        # Восстанавливаем downloader.py
        shutil.copy2(
            backup,
            DOWNLOADER
        )

        # Восстанавливаем старый sources_soundcloud.py,
        # если он существовал до запуска
        if module_backup is not None:

            try:

                shutil.copy2(
                    module_backup,
                    SOUNDCLOUD_MODULE
                )

            except Exception:
                pass

        else:

            # Если модуля до запуска не существовало,
            # удаляем созданный патчем файл.
            try:

                if os.path.isfile(
                    SOUNDCLOUD_MODULE
                ):
                    os.remove(
                        SOUNDCLOUD_MODULE
                    )

            except Exception:
                pass

        print(
            "Backup восстановлен."
        )

        raise

    # ---------------------------------------------------------
    # Успешное завершение
    # ---------------------------------------------------------

    print(
        "\n" + "=" * 70
    )

    print(
        "ПЕРЕНОС SOUNDCLOUD УСПЕШНО ЗАВЕРШЁН"
    )

    print(
        "=" * 70
    )

    print(
        "downloader.py теперь импортирует "
        "SoundCloud из sources_soundcloud.py."
    )

    print(
        "SoundCloud-функции удалены из downloader.py "
        "и перенесены в отдельный модуль."
    )

    print(
        "Остальная логика downloader.py "
        "не переносилась."
    )

    print(
        "\nИсточник SoundCloud:"
    )

    print(
        source_path
    )

    print(
        "\nBackup текущего downloader.py:"
    )

    print(
        backup
    )


if __name__ == "__main__":

    try:

        main()

    except Exception as error:

        print(
            "\n" + "=" * 70
        )

        print(
            "ОШИБКА ПРИ ПЕРЕНОСЕ SOUNDCLOUD"
        )

        print(
            "=" * 70
        )

        print(
