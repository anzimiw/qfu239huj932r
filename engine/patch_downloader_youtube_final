
# -*- coding: utf-8 -*-

"""
CENSURU.NET — ПЕРЕНОС MP3TM В ОТДЕЛЬНЫЙ МОДУЛЬ
PATCH v2

Переносит search_mp3tm() из downloader.py
в sources_mp3tm.py.

ВАЖНО:
- не вставляет импорт внутрь try/except;
- перед изменением восстанавливает downloader.py
  из backup предыдущего неудачного патча;
- создаёт новый backup перед успешным переносом;
- проверяет AST обоих файлов;
"""

from __future__ import annotations

import ast
import shutil
import sys
from datetime import datetime
from pathlib import Path


# ============================================================
# ПУТИ
# ============================================================

ENGINE_DIR = Path(__file__).resolve().parent

DOWNLOADER = ENGINE_DIR / "downloader.py"
SOURCES_MP3TM = ENGINE_DIR / "sources_mp3tm.py"

PREVIOUS_BACKUP = (
    ENGINE_DIR /
    "downloader.py.backup_mp3tm_20260824_185532"
)


# ============================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ============================================================

def fail(message):
    print()
    print("ОШИБКА:")
    print(message)
    print()
    sys.exit(1)


def read_text(path):
    for encoding in ("utf-8", "utf-8-sig", "cp1251"):
        try:
            return path.read_text(encoding=encoding)
        except UnicodeDecodeError:
            pass

    fail(f"Не удалось прочитать файл:\n{path}")


def write_text(path, text):
    path.write_text(text, encoding="utf-8", newline="\n")


def parse(text, filename):
    try:
        return ast.parse(text, filename=str(filename))
    except SyntaxError as e:
        fail(
            f"Синтаксическая ошибка в {filename.name}:\n"
            f"строка {e.lineno}, столбец {e.offset}\n"
            f"{e.msg}"
        )


def get_functions(tree):
    return {
        node.name: node
        for node in tree.body
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
    }


def get_function_source(text, node):
    lines = text.splitlines(keepends=True)

    start = node.lineno - 1
    end = node.end_lineno

    return "".join(lines[start:end])


def called_names(node):
    result = set()

    for child in ast.walk(node):
        if isinstance(child, ast.Call):

            if isinstance(child.func, ast.Name):
                result.add(child.func.id)

            elif isinstance(child.func, ast.Attribute):
                result.add(child.func.attr)

    return result


def get_top_level_imports(tree):
    result = []

    for node in tree.body:
        if isinstance(node, (ast.Import, ast.ImportFrom)):
            result.append(node)

    return result


def import_names(node):
    names = set()

    if isinstance(node, ast.Import):
        for alias in node.names:
            names.add(alias.asname or alias.name.split(".")[0])

    elif isinstance(node, ast.ImportFrom):
        for alias in node.names:
            names.add(alias.asname or alias.name)

    return names


def remove_function(text, node):
    lines = text.splitlines(keepends=True)

    start = node.lineno - 1
    end = node.end_lineno

    result = lines[:start] + lines[end:]

    return "".join(result)


def clean_blank_lines(text):
    lines = text.splitlines()

    result = []
    blanks = 0

    for line in lines:

        if not line.strip():
            blanks += 1

            if blanks <= 2:
                result.append("")

        else:
            blanks = 0
            result.append(line)

    return "\n".join(result).rstrip() + "\n"


# ============================================================
# ДОБАВЛЕНИЕ ИМПОРТА
# ============================================================

def add_import_safely(text):
    """
    Добавляет импорт только на верхний уровень модуля.

    Никогда не пытается вставлять его внутрь try/except,
    функции, класса или другой конструкции.
    """

    import_line = "from sources_mp3tm import search_mp3tm"

    if import_line in text:
        return text

    tree = parse(text, DOWNLOADER)

    lines = text.splitlines(keepends=True)

    # --------------------------------------------------------
    # Ищем верхнеуровневые импорты
    # --------------------------------------------------------

    import_nodes = [
        node
        for node in tree.body
        if isinstance(node, (ast.Import, ast.ImportFrom))
    ]

    # --------------------------------------------------------
    # Случай 1:
    # Есть обычный блок импортов в начале файла.
    # --------------------------------------------------------

    if import_nodes:

        last_import = max(
            import_nodes,
            key=lambda node: node.end_lineno
        )

        insert_index = last_import.end_lineno

        lines.insert(
            insert_index,
            import_line + "\n"
        )

        return "".join(lines)

    # --------------------------------------------------------
    # Случай 2:
    # Импортов вообще нет.
    #
    # Вставляем после module docstring.
    # --------------------------------------------------------

    insert_index = 0

    if (
        tree.body
        and isinstance(tree.body[0], ast.Expr)
        and isinstance(
            getattr(tree.body[0], "value", None),
            ast.Constant
        )
        and isinstance(
            tree.body[0].value.value,
            str
        )
    ):
        insert_index = tree.body[0].end_lineno

    lines.insert(
        insert_index,
        import_line + "\n"
    )

    return "".join(lines)


# ============================================================
# ОСНОВНАЯ ФУНКЦИЯ
# ============================================================

def main():

    print("=" * 70)
    print("CENSURU.NET — ПЕРЕНОС MP3TM")
    print("PATCH v2")
    print("=" * 70)

    # --------------------------------------------------------
    # 1
    # --------------------------------------------------------

    print()
    print("1/8: проверка downloader.py...")

    if not DOWNLOADER.exists():
        fail(
            f"Не найден downloader.py:\n{DOWNLOADER}"
        )

    original_text = read_text(DOWNLOADER)

    # Если после предыдущего неудачного патча downloader.py
    # оказался повреждён — восстанавливаем его.
    try:
        original_tree = ast.parse(
            original_text,
            filename=str(DOWNLOADER)
        )

        print("  OK: синтаксис корректен")

    except SyntaxError:

        print("  ВНИМАНИЕ: текущий downloader.py повреждён.")
        print("  Проверяем backup предыдущего запуска...")

        if not PREVIOUS_BACKUP.exists():
            fail(
                "Текущий downloader.py содержит синтаксическую ошибку, "
                "но backup предыдущего запуска не найден."
            )

        backup_text = read_text(PREVIOUS_BACKUP)

        try:
            ast.parse(
                backup_text,
                filename=str(PREVIOUS_BACKUP)
            )
        except SyntaxError:
            fail(
                "Backup предыдущего запуска тоже содержит "
                "синтаксическую ошибку."
            )

        shutil.copy2(
            PREVIOUS_BACKUP,
            DOWNLOADER
        )

        original_text = backup_text
        original_tree = ast.parse(
            original_text,
            filename=str(DOWNLOADER)
        )

        print("  OK: downloader.py восстановлен из backup")

    # --------------------------------------------------------
    # 2
    # --------------------------------------------------------

    print()
    print("2/8: поиск search_mp3tm()...")

    functions = get_functions(original_tree)

    if "search_mp3tm" not in functions:
        fail(
            "Функция search_mp3tm() не найдена."
        )

    search_node = functions["search_mp3tm"]

    print(
        "  OK: search_mp3tm() найдена "
        f"(строки {search_node.lineno}-{search_node.end_lineno})"
    )

    # --------------------------------------------------------
    # 3
    # --------------------------------------------------------

    print()
    print("3/8: анализ search_mp3tm()...")

    search_source = get_function_source(
        original_text,
        search_node
    )

    calls = called_names(search_node)

    print(
        f"  OK: размер функции: "
        f"{len(search_source.splitlines())} строк"
    )

    print(
        f"  OK: обнаружено вызовов: {len(calls)}"
    )

    # --------------------------------------------------------
    # 4
    # --------------------------------------------------------

    print()
    print("4/8: подготовка sources_mp3tm.py...")

    if SOURCES_MP3TM.exists():

        existing = read_text(SOURCES_MP3TM)

        try:
            existing_tree = ast.parse(
                existing,
                filename=str(SOURCES_MP3TM)
            )
        except SyntaxError:
            fail(
                "Существующий sources_mp3tm.py содержит "
                "синтаксическую ошибку.\n"
                "Удалите его вручную и повторите запуск."
            )

        existing_functions = get_functions(
            existing_tree
        )

        if "search_mp3tm" in existing_functions:
            fail(
                "sources_mp3tm.py уже содержит "
                "search_mp3tm().\n"
                "Перенос уже выполнен или файл создан "
                "предыдущим патчем."
            )

        print(
            "  ВНИМАНИЕ: sources_mp3tm.py существует, "
            "но search_mp3tm() отсутствует."
        )

        print(
            "  Файл будет заменён новой корректной версией."
        )

    else:
        print(
            "  OK: sources_mp3tm.py отсутствует, "
            "можно создать"
        )

    # --------------------------------------------------------
    # 5
    # --------------------------------------------------------

    print()
    print("5/8: создание резервной копии...")

    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    backup = ENGINE_DIR / (
        f"downloader.py.backup_mp3tm_v2_{timestamp}"
    )

    shutil.copy2(
        DOWNLOADER,
        backup
    )

    print(f"  OK: резервная копия:")
    print(f"  {backup}")

    # --------------------------------------------------------
    # 6
    # Создаём sources_mp3tm.py
    # --------------------------------------------------------

    print()
    print("6/8: создание sources_mp3tm.py...")

    imports = get_top_level_imports(
        original_tree
    )

    needed_imports = []

    # Все имена, которые использует search_mp3tm.
    used_names = set(calls)

    for node in imports:

        names = import_names(node)

        if names & used_names:

            import_text = ast.unparse(node)

            if (
                import_text
                not in needed_imports
            ):
                needed_imports.append(
                    import_text
                )

    # Общие функции.
    #
    # Пока они остаются в downloader.py.
    # Поэтому в sources_mp3tm.py мы создаём локальные копии
    # только тех общих функций, которые реально нужны
    # search_mp3tm().
    #
    # Это временное безопасное решение.
    shared_names = {
        "normalize",
        "normalize_words",
        "candidate_text_score",
        "is_duration_acceptable",
    }

    needed_shared = []

    for name in shared_names:

        if (
            name in calls
            and name in functions
        ):
            needed_shared.append(name)

    module = []

    module.append("# -*- coding: utf-8 -*-")
    module.append("")
    module.append('"""')
    module.append("CENSURU.NET — ИСТОЧНИК MP3TM")
    module.append("")
    module.append(
        "Поиск и выбор треков MP3TM."
    )
    module.append("")
    module.append(
        "Логика вынесена из downloader.py."
    )
    module.append('"""')
    module.append("")

    # Импорты.
    if needed_imports:
        module.extend(needed_imports)
        module.append("")

    # Общие функции.
    if needed_shared:

        module.append(
            "# ============================================================"
        )
        module.append(
            "# ОБЩИЕ ФУНКЦИИ, НЕОБХОДИМЫЕ MP3TM"
        )
        module.append(
            "# ============================================================"
        )
        module.append("")

        for name in needed_shared:

            node = functions[name]

            module.append(
                get_function_source(
                    original_text,
                    node
                ).rstrip()
            )

            module.append("")

    # MP3TM.
    module.append(
        "# ============================================================"
    )
    module.append(
        "# MP3TM SEARCH"
    )
    module.append(
        "# ============================================================"
    )
    module.append("")

    module.append(
        search_source.rstrip()
    )

    module.append("")

    source_text = clean_blank_lines(
        "\n".join(module)
    )

    # Проверяем ДО записи.
    source_tree = parse(
        source_text,
        SOURCES_MP3TM
    )

    write_text(
        SOURCES_MP3TM,
        source_text
    )

    print("  OK: sources_mp3tm.py создан")
    print("  OK: синтаксис корректен")

    # --------------------------------------------------------
    # 7
    # Удаляем функцию из downloader.py
    # --------------------------------------------------------

    print()
    print("7/8: изменение downloader.py...")

    modified = remove_function(
        original_text,
        search_node
    )

    modified = clean_blank_lines(
        modified
    )

    # ВАЖНО:
    # Сначала добавляем импорт.
    #
    # Но после удаления функции заново парсим файл.
    # Импорт будет вставлен только среди top-level imports.
    modified = add_import_safely(
        modified
    )

    # --------------------------------------------------------
    # КРИТИЧЕСКАЯ ПРОВЕРКА
    # --------------------------------------------------------

    try:
        modified_tree = ast.parse(
            modified,
            filename=str(DOWNLOADER)
        )

    except SyntaxError as e:

        print()
        print(
            "КРИТИЧЕСКАЯ ОШИБКА: "
            "новый downloader.py не прошёл AST."
        )

        print(
            f"Строка: {e.lineno}"
        )

        print(
            f"Ошибка: {e.msg}"
        )

        print()
        print(
            "Исходный downloader.py НЕ перезаписывается."
        )

        print(
            f"Резервная копия:\n{backup}"
        )

        # Удаляем созданный sources_mp3tm.py,
        # чтобы не оставлять полусостояние.
        if SOURCES_MP3TM.exists():
            SOURCES_MP3TM.unlink()

        sys.exit(1)

    modified_functions = get_functions(
        modified_tree
    )

    if "search_mp3tm" in modified_functions:

        print(
            "  ОШИБКА: search_mp3tm() "
            "не была удалена из downloader.py"
        )

        print(
            f"Восстановите из backup:\n{backup}"
        )

        sys.exit(1)

    if (
        "from sources_mp3tm import search_mp3tm"
        not in modified
    ):

        print(
            "  ОШИБКА: импорт sources_mp3tm "
            "не найден."
        )

        print(
            f"Восстановите из backup:\n{backup}"
        )

        sys.exit(1)

    # --------------------------------------------------------
    # Только теперь записываем downloader.py.
    # --------------------------------------------------------

    write_text(
        DOWNLOADER,
        modified
    )

    print(
        "  OK: search_mp3tm() удалена"
    )

    print(
        "  OK: импорт sources_mp3tm добавлен"
    )

    print(
        "  OK: downloader.py записан"
    )

    # --------------------------------------------------------
    # 8
    # Финальная проверка
    # --------------------------------------------------------

    print()
    print("8/8: финальная проверка...")

    final_downloader = read_text(
        DOWNLOADER
    )

    final_source = read_text(
        SOURCES_MP3TM
    )

    final_downloader_tree = parse(
        final_downloader,
        DOWNLOADER
    )

    final_source_tree = parse(
        final_source,
        SOURCES_MP3TM
    )

    final_downloader_functions = get_functions(
        final_downloader_tree
    )

    final_source_functions = get_functions(
        final_source_tree
    )

    # search_mp3tm должен быть только в новом модуле.
    if "search_mp3tm" in final_downloader_functions:
        fail(
            "ФИНАЛЬНАЯ ПРОВЕРКА НЕ ПРОЙДЕНА:\n"
            "search_mp3tm() всё ещё находится "
            "в downloader.py."
        )

    print(
        "  OK: search_mp3tm() отсутствует "
        "в downloader.py"
    )

    if "search_mp3tm" not in final_source_functions:
        fail(
            "ФИНАЛЬНАЯ ПРОВЕРКА НЕ ПРОЙДЕНА:\n"
            "search_mp3tm() отсутствует "
            "в sources_mp3tm.py."
        )

    print(
        "  OK: search_mp3tm() находится "
        "в sources_mp3tm.py"
    )

    if (
        "from sources_mp3tm import search_mp3tm"
        not in final_downloader
    ):
        fail(
            "ФИНАЛЬНАЯ ПРОВЕРКА НЕ ПРОЙДЕНА:\n"
            "downloader.py не импортирует "
            "search_mp3tm."
        )

    print(
        "  OK: импорт search_mp3tm присутствует"
    )

    # Проверяем отсутствие импорта downloader
    # из sources_mp3tm.
    for line in final_source.splitlines():

        stripped = line.strip()

        if (
            stripped == "import downloader"
            or stripped.startswith(
                "from downloader import"
            )
        ):
            fail(
                "sources_mp3tm.py импортирует "
                "downloader.py."
            )

    print(
        "  OK: циклической зависимости нет"
    )

    # compile.
    compile(
        final_downloader,
        str(DOWNLOADER),
        "exec"
    )

    compile(
        final_source,
        str(SOURCES_MP3TM),
        "exec"
    )

    print(
        "  OK: compile() обоих файлов успешен"
    )

    # --------------------------------------------------------
    # ИТОГ
    # --------------------------------------------------------

    print()
    print("=" * 70)
    print("MP3TM УСПЕШНО ВЫНЕСЕН")
    print("=" * 70)

    print()
    print("Создан:")
    print(f"  {SOURCES_MP3TM}")

    print()
    print("Изменён:")
    print(f"  {DOWNLOADER}")

    print()
    print("Backup:")
    print(f"  {backup}")

    print()
    print("Структура теперь:")
    print()
    print("  downloader.py")
    print("       │")
    print("       └── search_mp3tm()")
    print("               ↓")
    print("       sources_mp3tm.py")

    print()
    print("SoundCloud и MP3Party остаются отдельно.")
    print("AudioStart пока не трогался.")
    print("=" * 70)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
