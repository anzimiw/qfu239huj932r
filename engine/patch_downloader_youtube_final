    "downloader.py.backup_sc_import_"
)


# ============================================================
# Общие функции
# ============================================================


def fail(message):
    raise RuntimeError(message)


def read_text(path):
    with open(
        path,
        "r",
        encoding="utf-8"
    ) as f:
        return f.read()


def write_text(path, text):
    with open(
        path,
        "w",
        encoding="utf-8",
        newline=""
    ) as f:
        f.write(text)


def parse(source, label):
    try:
        return ast.parse(source)
    except SyntaxError as e:
        fail(
            f"{label} содержит синтаксическую ошибку:\n{e}"
        )


def top_functions(tree):
    return {
        node.name: node
        for node in tree.body
        if isinstance(
            node,
            (
                ast.FunctionDef,
                ast.AsyncFunctionDef
            )
        )
    }


def top_imports(tree):
    return [
        node
        for node in tree.body
        if isinstance(
            node,
            (
                ast.Import,
                ast.ImportFrom
            )
        )
    ]


def sha256_file(path):
    h = hashlib.sha256()

    with open(
        path,
        "rb"
    ) as f:

        while True:

            chunk = f.read(
                1024 * 1024
            )

            if not chunk:
                break

            h.update(chunk)

    return h.hexdigest()


# ============================================================
# Проверка текущего downloader.py
# ============================================================


def validate_current_downloader():
    if not DOWNLOADER.is_file():
        fail(
            "Не найден downloader.py:\n"
            + str(DOWNLOADER)
        )

    source = read_text(
        DOWNLOADER
    )

    tree = parse(
        source,
        "текущий downloader.py"
    )

    funcs = top_functions(
        tree
    )

    return source, tree, funcs


# ============================================================
# Поиск локального SoundCloud-модуля
# ============================================================


def validate_soundcloud_module_text(
    source,
    label
):
    tree = parse(
        source,
        label
    )

    funcs = top_functions(
        tree
    )

    missing = [
        name
        for name in EXPECTED_FUNCTIONS
        if name not in funcs
    ]

    if missing:
        return False, missing

    return True, []


def check_local_module():
    if not SOUNDCLOUD_MODULE.is_file():
        return None

    try:
        source = read_text(
            SOUNDCLOUD_MODULE
        )

        valid, missing = (
            validate_soundcloud_module_text(
                source,
                "локальный sources_soundcloud.py"
            )
        )

        if valid:
            return source

    except Exception:
        pass

    return None


# ============================================================
# Загрузка источника GitHub
# ============================================================


def download_github_module():
    print()
    print(
        "Проверка источника SoundCloud на GitHub..."
    )

    print(
        "  URL:"
    )

    print(
        f"  {GITHUB_MODULE_URL}"
    )

    try:

        request = urllib.request.Request(
            GITHUB_MODULE_URL,
            headers={
                "User-Agent":
                    "Censuru.net-SoundCloud-Patcher/1.0"
            }
        )

        with urllib.request.urlopen(
            request,
            timeout=20
        ) as response:

            data = response.read()

        source = data.decode(
            "utf-8"
        )

    except Exception as error:

        print(
            "  GitHub-источник недоступен:"
        )

        print(
            f"  {type(error).__name__}: {error}"
        )

        return None

    if not source.strip():
        print(
            "  GitHub вернул пустой файл."
        )
        return None

    try:

        valid, missing = (
            validate_soundcloud_module_text(
                source,
                "sources_soundcloud.py из GitHub"
            )
        )

    except Exception as error:

        print(
            "  Полученный файл содержит "
            "синтаксическую ошибку:"
        )

        print(
            f"  {error}"
        )

        return None

    if not valid:

        print(
            "  GitHub-файл не является "
            "полным SoundCloud-модулем."
        )

        print(
            "  Отсутствуют функции:"
        )

        for name in missing:
            print(
                f"    - {name}"
            )

        return None

    print(
        "  OK: найден полноценный "
        "sources_soundcloud.py"
    )

    return source


# ============================================================
# Поиск SoundCloud-кода в локальных файлах
# ============================================================


def find_local_soundcloud_sources():
    """
    Ищет полноценный SoundCloud-модуль среди файлов engine.

    Это запасной вариант на случай, если GitHub-файл
    недоступен, но модуль был сохранён где-то локально.
    """

    found = []

    patterns = (
        "sources_soundcloud*.py",
        "*soundcloud*.py",
    )

    seen = set()

    for pattern in patterns:

        for path in ENGINE_DIR.glob(pattern):

            if not path.is_file():
                continue

            resolved = str(
                path.resolve()
            )

            if resolved in seen:
                continue

            seen.add(resolved)

            if path.name == (
                "patch_move_soundcloud_from_github_v1.py"
            ):
                continue

            try:

                source = read_text(
                    path
                )

                valid, missing = (
                    validate_soundcloud_module_text(
                        source,
                        str(path)
                    )
                )

                if valid:
                    found.append(
                        (
                            path,
                            source
                        )
                    )

            except Exception:
                continue

    return found


# ============================================================
# Backup
# ============================================================


def create_backup():
    stamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    backup = (
        ENGINE_DIR
        / f"{BACKUP_PREFIX}{stamp}.py"
    )

    shutil.copy2(
        DOWNLOADER,
        backup
    )

    return backup


def create_module_backup():
    if not SOUNDCLOUD_MODULE.is_file():
        return None

    stamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    backup = (
        ENGINE_DIR
        / (
            "sources_soundcloud.py.backup_sc_import_"
            f"{stamp}"
        )
    )

    shutil.copy2(
        SOUNDCLOUD_MODULE,
        backup
    )

    return backup


# ============================================================
# Импорт в downloader.py
# ============================================================


def ensure_soundcloud_import(
    source
):
    """
    Добавляет правильный top-level import.

    Если импорт уже есть — ничего не меняет.

    Если есть старый импорт SoundCloud —
    удаляет его и ставит один корректный импорт.
    """

    tree = parse(
        source,
        "downloader.py"
    )

    lines = source.splitlines(
        keepends=True
    )

    import_nodes = []

    for node in tree.body:

        if not isinstance(
            node,
            ast.ImportFrom
        ):
            continue

        if node.module != (
            "sources_soundcloud"
        ):
            continue

        import_nodes.append(
            node
        )

    correct_import = (
        "\n"
        "from sources_soundcloud import (\n"
        "    get_soundcloud_client_id,\n"
        "    normalize_soundcloud_metadata,\n"
        "    evaluate_soundcloud_candidate,\n"
        "    fetch_soundcloud_results,\n"
        "    search_soundcloud,\n"
        "    download_from_soundcloud,\n"
        ")\n"
    )

    # --------------------------------------------------------
    # Уже правильный импорт
    # --------------------------------------------------------

    if len(import_nodes) == 1:

        node = import_nodes[0]

        imported = []

        for alias in node.names:
            imported.append(
                alias.name
            )

        if all(
            name in imported
            for name in EXPECTED_FUNCTIONS
        ):

            return source

    # --------------------------------------------------------
    # Удаляем существующие top-level
    # imports sources_soundcloud
    # --------------------------------------------------------

    for node in sorted(
        import_nodes,
        key=lambda n: n.lineno,
        reverse=True
    ):

        del lines[
            node.lineno - 1:
            node.end_lineno
        ]

    source = "".join(
        lines
    )

    # --------------------------------------------------------
    # Заново парсим после удаления
    # --------------------------------------------------------

    tree = parse(
        source,
        "downloader.py после очистки импорта"
    )

    lines = source.splitlines(
        keepends=True
    )

    imports = [
        node
        for node in tree.body
        if isinstance(
            node,
            (
                ast.Import,
                ast.ImportFrom
            )
        )
    ]

    if imports:

        last_import = max(
            imports,
            key=lambda n: n.end_lineno
        )

        lines.insert(
            last_import.end_lineno,
            correct_import
        )

        return "".join(
            lines
        )

    return (
        correct_import.lstrip("\n")
        + "\n"
        + source
    )


# ============================================================
# Проверка результата
# ============================================================


def validate_final_downloader(
    source
):
    tree = parse(
        source,
        "изменённый downloader.py"
    )

    imports = [
        node
        for node in tree.body
        if isinstance(
            node,
            ast.ImportFrom
        )
        and node.module == (
            "sources_soundcloud"
        )
    ]

    if len(imports) != 1:

        fail(
            "После патча должен существовать "
            "ровно один top-level import "
            "sources_soundcloud."
        )

    imported = {
        alias.name
        for alias in imports[0].names
    }

    missing = [
        name
        for name in EXPECTED_FUNCTIONS
        if name not in imported
    ]

    if missing:

        fail(
            "В import sources_soundcloud "
            "не хватает функций:\n"
            + "\n".join(
                "  - " + name
                for name in missing
            )
        )

    # SoundCloud-функции не должны снова
    # находиться непосредственно в downloader.py.

    funcs = top_functions(
        tree
    )

    forbidden = [
        name
        for name in EXPECTED_FUNCTIONS
        if name in funcs
    ]

    if forbidden:

        fail(
            "Следующие SoundCloud-функции "
            "не должны находиться непосредственно "
            "в downloader.py:\n"
            + "\n".join(
                "  - " + name
                for name in forbidden
            )
        )


def validate_final_module():
    py_compile.compile(
        str(SOUNDCLOUD_MODULE),
        doraise=True
    )

    source = read_text(
        SOUNDCLOUD_MODULE
    )

    valid, missing = (
        validate_soundcloud_module_text(
            source,
            "финальный sources_soundcloud.py"
        )
    )

    if not valid:

        fail(
            "Финальный sources_soundcloud.py "
            "не содержит:\n"
            + "\n".join(
                "  - " + name
                for name in missing
            )
        )


