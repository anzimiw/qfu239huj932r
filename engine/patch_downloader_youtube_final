def patch_process_single_track(text):
    old_call = '''    filepath = find_and_download_track(
        artist,
        title,
        duration,
        output_folder,
        source_url,
        source
    )
'''

    new_call = '''    filepath = find_and_download_track(
        artist,
        title,
        duration,
        output_folder,
        source_url,
        source,
        info.get(
            "youtube_age_restricted",
            False
        )
    )
'''

    if old_call not in text:
        raise RuntimeError(
            "Не найден вызов "
            "find_and_download_track()."
        )

    return text.replace(
        old_call,
        new_call,
        1
    )


