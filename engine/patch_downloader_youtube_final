    ENGINE_DIR / "sources_soundcloud.py"
)

GITHUB_MODULE_URL = (
    "https://raw.githubusercontent.com/"
    "anzimiw/qfu239huj932r/main/"
    "engine/sources_soundcloud.py"
)

EXPECTED_FUNCTIONS = (
    "get_soundcloud_client_id",
    "normalize_soundcloud_metadata",
    "evaluate_soundcloud_candidate",
    "fetch_soundcloud_results",
    "search_soundcloud",
    "download_from_soundcloud",
)

